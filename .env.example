# --- Copie ce fichier en ".env" et remplis les valeurs (ou renseigne-les dans Railway > Variables) ---

# Mot de passe du coordinateur (choisis-en un solide)
ADMIN_PASSWORD=change-moi

# URL publique de l'app une fois déployée (sert à construire les liens perso dans les emails)
BASE_URL=https://espace.artisandeconfiance13.fr

# Emails (Brevo). Sans BREVO_API_KEY, l'app tourne quand même : elle logue les emails au lieu de les envoyer.
BREVO_API_KEY=
MAIL_FROM=contact@artisandeconfiance13.fr
MAIL_FROM_NAME=Artisan de Confiance du 13

# Où stocker les données (sur Railway/Render, pointe vers un volume persistant, ex: /data)
DATA_DIR=./data

# Port (Railway/Render le fournissent automatiquement via PORT)
PORT=3000